{"setting": "calib_Hdim_a1.5", "task": "T1", "idx": 0, "label": "dfs", "pass": false, "frac_correct": 0.06, "frac_shortest": 0.04, "oracle_status": "ok", "code_hash": "3be551ca34a8c7069dc59c02553787a4634309fd", "stripped": "defdfs_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_rec_grec_recrecg\n\ndef find_path(graph, start, goal):\n\n    def dfs(start, goal, path, visited):\n        path.append(start)\n        if start == goal:\n            return path\n        visited.add(start)\n        for neighbor in graph.get(start, []):\n            if neighbor not in visited:\n                new_path = dfs(neighbor, goal, path.copy(), visited.copy())\n                if new_path:\n                    return new_path\n        path.pop()\n        return None\n    visited = set()\n    return dfs(start, goal, [], visited)\ngraph = {'A': ['B', 'C'], 'B': ['D', 'E'], 'C': ['F'], 'D': [], 'E': ['F'], 'F': []}\nstart_node = 'A'\nend_node = 'F'\npath = find_path(graph, start_node, end_node)\nif path:\n    print(path)\nelse:\n    print('No path found from {} to {}'.format(start_node, end_node))", "extract": "python_block", "ntoks": 288, "deg_no_code": false, "deg_syntax_error": false, "deg_truncated": false, "deg_looping": false, "deg_missing_function": false}
