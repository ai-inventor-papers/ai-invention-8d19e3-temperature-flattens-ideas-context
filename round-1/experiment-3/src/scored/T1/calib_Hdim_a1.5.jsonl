{"setting": "calib_Hdim_a1.5", "task": "T1", "idx": 10, "label": "bfs", "pass": true, "frac_correct": 1.0, "frac_shortest": 1.0, "oracle_status": "ok", "code_hash": "8b8d21ee093f04ba0bb234f0777a41a4ef504d25", "stripped": "def find_path(graph, start, goal):\n    if start not in graph or goal not in graph:\n        return None\n    open_list = [start]\n    closed_list = []\n    path = {}\n    while open_list:\n        current = open_list.pop(0)\n        if current == goal:\n            return reconstruct_path(path, start, goal)\n        if current not in closed_list:\n            closed_list.append(current)\n            neighbors = graph.get(current, [])\n            for neighbor in neighbors:\n                if neighbor not in closed_list and neighbor not in open_list:\n                    open_list.append(neighbor)\n                    path[neighbor] = current\n    return None\n\ndef reconstruct_path(path, start, goal):\n    current = goal\n    path_list = []\n    while current != start:\n        path_list.append(current)\n        current = path.get(current)\n    path_list.append(start)\n    path_list.reverse()\n    return path_list\ngraph = {'A': ['B', 'C'], 'B': ['A', 'D', 'G'], 'C': ['A', 'F', 'H'], 'D': ['B', 'E'], 'E': ['D'], 'F': ['C'], 'G': ['B', 'H', 'I'], 'H': ['F', 'G', 'I'], 'I': ['G', 'H']}\nprint(find_path(graph, 'A', 'I'))", "extract": "python_block", "ntoks": 375, "deg_no_code": false, "deg_syntax_error": false, "deg_truncated": false, "deg_looping": false, "deg_missing_function": false}
